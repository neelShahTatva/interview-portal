<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="016-create-candidate-history" author="interview-portal">
        <createTable tableName="candidate_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="candidate_id" type="BIGINT"/>

            <column name="first_name" type="VARCHAR(255)"/>

            <column name="last_name" type="VARCHAR(255)"/>

            <column name="email" type="VARCHAR(255)"/>

            <column name="experience" type="INTEGER"/>

            <column name="designation" type="VARCHAR(255)"/>

            <column name="is_active" type="BOOLEAN"/>

            <column name="created_at" type="TIMESTAMP"/>

            <column name="created_by" type="BIGINT"/>

            <column name="updated_at" type="TIMESTAMP"/>

            <column name="updated_by" type="BIGINT"/>

            <column name="comment" type="VARCHAR(100)"/>

            <column name="last_appeared_at" type="TIMESTAMP"/>

            <column name="deleted_by" type="BIGINT"/>

            <column name="deleted_at" type="TIMESTAMP"/>

            <column name="result" type="VARCHAR(255)"/>

            <column name="ai_score" type="INTEGER"/>

            <column name="action_performed" type="VARCHAR(20)"/>

        </createTable>
    </changeSet>

</databaseChangeLog>