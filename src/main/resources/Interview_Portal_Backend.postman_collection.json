{
  "info": {
    "name": "Interview Portal Backend API",
    "description": "Postman collection generated by analyzing the Spring Boot backend source in AI_Practicle/interview-portal. Base URL defaults to http://localhost:8080. Most success responses use ApiResponse {statusCode, success, errorMessages, result}; dashboard endpoints use {success, message, result}. Auth endpoints and public/security behavior should be verified against the running profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "candidateId",
      "value": "1"
    },
    {
      "key": "assessmentId",
      "value": "1"
    },
    {
      "key": "questionId",
      "value": "1"
    },
    {
      "key": "submissionId",
      "value": "1"
    },
    {
      "key": "roleId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "On success, attempts to save result.accessToken and result.refreshToken to collection variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"HTTP response is successful\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                    "let j={}; try { j=pm.response.json(); } catch(e) {}",
                    "const r=j.result || j.data || j;",
                    "if (r.accessToken) pm.collectionVariables.set(\"accessToken\", r.accessToken);",
                    "if (r.refreshToken) pm.collectionVariables.set(\"refreshToken\", r.refreshToken);"
                  ]
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ],
              "query": [
                {
                  "key": "refreshToken",
                  "value": "{{refreshToken}}",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
